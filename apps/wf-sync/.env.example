# Wealthfolio server (see docker-compose.yml)
WF_PASSWORD=change-me
# argon2id hash of WF_PASSWORD. With Bun (no extra tools):
#   bun -e 'console.log(await Bun.password.hash("change-me", { algorithm: "argon2id" }))'
# or: printf 'change-me' | argon2 "$(openssl rand -hex 16)" -id -e
# In .env single-quote it because it contains '$'
WF_AUTH_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$...'
# 32 random bytes, base64:  openssl rand -base64 32
WF_SECRET_KEY=
# Where you open the UI from (required by Wealthfolio when auth is on)
WF_CORS_ALLOW_ORIGINS=http://localhost:8088

# Exchanges — READ-ONLY keys
BINANCE_API_KEY=
BINANCE_SECRET=
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
KRAKEN_API_KEY=
KRAKEN_SECRET=
WHITEBIT_API_KEY=
WHITEBIT_SECRET=

# Monobank personal token: https://api.monobank.ua/
MONOBANK_TOKEN=

TZ=Europe/Kyiv
