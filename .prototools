# Canon pins. This file is sync-managed: edits happen in alxwlw/stack, not here.
proto = "0.63.1"
node = "26.12.0"
pnpm = "11.28.6"
bun = "1.4.3"
moon = "2.6.2"
uv = "0.13.1"

# Guardrail binaries: versions pinned for reproducibility.
actionlint = "1.7.12"
shellcheck = "0.11.0"
gitleaks = "8.30.1"

[plugins]
# Vendored: upstream github.com/Phault/proto-toml-plugins was removed 2026-09-13, its URL now returns 404.
actionlint = "file://./.moon/proto-plugins/actionlint.toml"
shellcheck = "file://./.moon/proto-plugins/shellcheck.toml"
gitleaks = "file://./.moon/proto-plugins/gitleaks.toml"
